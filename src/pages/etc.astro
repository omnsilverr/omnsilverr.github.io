---
import SiteLayout from '../layouts/SiteLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, isInGroup } from '../lib/posts';
const posts = (await getPosts()).filter(post => isInGroup(post, 'etc.'));
---
<SiteLayout title="ETC." active="etc.">
  <div class="page-heading"><h1>etc.</h1><span>{posts.length}개의 글</span></div>
  <PostList posts={posts} />
</SiteLayout>
