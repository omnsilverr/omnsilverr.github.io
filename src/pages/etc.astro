---
import SiteLayout from '../layouts/SiteLayout.astro';
import PostList from '../components/PostList.astro';
import { boards } from '../config/boards';
import { getPosts } from '../lib/posts';
const ids = new Set(boards.filter(b => b.group === 'journal').map(b => b.id));
const posts = (await getPosts()).filter(p => p.data.category && ids.has(p.data.category));
---
<SiteLayout title="ETC" active="etc.">
  <div class="page-heading"><h1>etc.</h1><span>{posts.length}개의 글</span></div>
  <PostList posts={posts} />
</SiteLayout>
