---
import SiteLayout from '../layouts/SiteLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, isInGroup } from '../lib/posts';
const posts = (await getPosts()).filter(post => isInGroup(post, 'study'));
---
<SiteLayout title="STUDY" active="study">
  <div class="page-heading"><h1>STUDY</h1><span>{posts.length}개의 글</span></div>
  <PostList posts={posts} />
</SiteLayout>
