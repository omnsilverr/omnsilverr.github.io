---
import { SITE_TITLE } from '../consts';
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/study/', label: 'Study' },
  { href: '/journal/', label: 'Journal' },
  { href: '/about/', label: 'About' },
];
---
<header class="site-header">
  <nav class="nav-inner" aria-label="주 메뉴">
    <a class="wordmark" href="/" aria-label={`${SITE_TITLE} 홈`}>
      <span class="mark-top">JIEUN</span>
      <span class="mark-bottom">ARCHIVE<span class="mark-period">.</span></span>
    </a>
    <div class="navigation">
      {links.map((link) => {
        const isActive = link.href === '/'
          ? pathname === '/'
          : pathname.startsWith(link.href);
        return <a href={link.href} class:list={{ active: isActive }} aria-current={isActive ? 'page' : undefined}>{link.label}</a>;
      })}
    </div>
  </nav>
</header>
<style>
  .site-header { border-bottom: 1px solid #e9e6df; background: #fcfbf9; }
  .nav-inner { max-width: 1060px; padding: 26px 34px 23px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .wordmark { display: inline-flex; flex-direction: column; text-decoration: none; color: #2d2d2b; line-height: 1; letter-spacing: .12em; }
  .mark-top { font-family: Georgia, 'Times New Roman', serif; font-size: 11px; letter-spacing: .32em; margin-bottom: 6px; font-weight: normal; }
  .mark-bottom { font-size: 15px; letter-spacing: .18em; font-weight: 700; }
  .mark-period { color: #8b8174; }
  .navigation { display: flex; align-items: center; gap: clamp(16px, 3vw, 42px); }
  .navigation a { color: #77736d; text-decoration: none; font-size: 13px; padding: 7px 0; transition: color .2s; border-bottom: 1px solid transparent; }
  .navigation a:hover, .navigation a.active { color: #2d2d2b; border-bottom-color: #847969; }
  @media(max-width:570px) {
    .nav-inner { padding: 20px 20px 16px; flex-direction: column; align-items: flex-start; gap: 20px; }
    .navigation { justify-content: space-between; gap: 18px; width: 100%; }
    .navigation a { font-size: 12px; }
  }
</style>
