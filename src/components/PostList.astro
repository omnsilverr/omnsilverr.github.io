---
import { boardLink } from '../config/boards';
import { getPostBoard, type Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <div class="empty-message">아직 작성된 글이 없습니다.</div>
) : (
  <div class="post-list">
    {posts.map(post => {
      const board = getPostBoard(post);
      return (
        <article class="post-item">
          <div class="post-meta">
            {board ? <a href={boardLink(board.id)}>{board.name}</a> : <span>미분류</span>}
            <span class="dot">·</span>
            <FormattedDate date={post.data.pubDate} />
          </div>
          <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          {post.data.description && <p>{post.data.description}</p>}
        </article>
      );
    })}
  </div>
)}
