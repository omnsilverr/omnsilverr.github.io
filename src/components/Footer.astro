---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <span class="footer-label">JIEUN ARCHIVE</span>
      <p>쌓이는 기록, 남는 생각.</p>
    </div>
    <div class="footer-right">
      <a href="https://github.com/omnsilverr" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <span>© {year}</span>
    </div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid #e9e6df; margin-top: 42px; }
  .footer-inner { max-width: 1060px; margin: auto; padding: 42px 34px 56px; display: flex; align-items: end; justify-content: space-between; gap: 20px; }
  .footer-label { color: #4e4b46; letter-spacing: .17em; font-size: 11px; font-weight: 700; }
  .footer-inner p { margin: 8px 0 0; font-size: 12px; color: #8b857d; }
  .footer-right { display: flex; gap: 24px; font-size: 12px; color: #918b82; }
  .footer-right a { color: #69645e; text-decoration: none; }
  .footer-right a:hover { color: #33302d; }
  @media(max-width:570px){.footer-inner{padding:32px 20px 44px;align-items:flex-start;}.footer-right{flex-direction:column;gap:10px;align-items:flex-end;}}
</style>
